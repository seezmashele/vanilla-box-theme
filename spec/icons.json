  "_families": "Breeze spells signal strength and charge level as a hundred-odd separate filenames. Writing those out by hand is how a mapping file goes stale, so a family is a name template with a level and any number of slots, and the generator multiplies it out. A slot alternative naming an icon overrides the level's — charging is the same picture whatever the charge — and one naming null keeps it, which is how a power profile changes the filename without changing the artwork. Mobile broadband is deliberately absent: it is another 160 names for hardware this theme's desktop does not have, and breeze-dark still answers them.",
  "families": [
    {
      "context": "status",
      "name": "battery-{level}{charging}{profile}",
      "levels": {
        "000": "battery-empty",
        "010": "battery-low",
        "020": "battery-low",
        "030": "battery-low",
        "040": "battery-medium",
        "050": "battery-medium",
        "060": "battery-medium",
        "070": "battery-high",
        "080": "battery-high",
        "090": "battery-high",
        "100": "battery-full"
      },
      "slots": {
        "charging": {
          "": null,
          "-charging": "battery-charging"
        },
        "profile": {
          "": null,
          "-profile-balanced": null,
          "-profile-performance": null,
          "-profile-powersave": null
        }
      }
    },
    {
