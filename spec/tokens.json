{
  "_comment": "The only hand-edited input to the generated artwork. See DESIGN.md.",

  "_foreground": "Text does not follow the tint. Warm text on a blue surface reads as a mistake rather than a variant, and holding it still keeps every tint recognisably the same theme.",
  "foreground": {
    "text": "#e8e4dd",
    "textInactive": "#8a8782",
    "onHighlight": "#1f1f1f"
  },

  "_palettes": "Surfaces only. Values are hand-tuned per tint rather than derived: a computed hue shift misbehaves at the lightness of the view background.",
  "palettes": {
    "neutral": {
      "background": "#292929",
      "backgroundAlt": "#2a2a2a",
      "elevated": "#2f2f2f",
      "elevatedAlt": "#383838",
      "view": "#141414",
      "focusDim": "#252525"
    },
    "slate": {
      "background": "#272a2f",
      "backgroundAlt": "#282b30",
      "elevated": "#2d3137",
      "elevatedAlt": "#363b42",
      "view": "#131519",
      "focusDim": "#23262b"
    },
    "rose": {
      "background": "#2b2727",
      "backgroundAlt": "#2c2828",
      "elevated": "#322d2d",
      "elevatedAlt": "#3b3535",
      "view": "#161313",
      "focusDim": "#272323"
    }
  },

  "_accents": "One colour each, driving both the shell's highlight and the KDE accent. Named apart from the tints so 'Colour: Slate, Accent: Slate' cannot happen.",
  "accents": {
    "sand": "#ae8e6c",
    "ash": "#8f8f8f",
    "moss": "#8ca882",
    "steel": "#7d93ad",
    "clay": "#b8776a",
    "plum": "#a288b0"
  },

  "status": {
    "hover": "#9e9e9e",
    "negative": "#da6262",
    "neutral": "#deab50",
    "positive": "#6cbb7c",
    "visited": "#b39f7e"
  },

  "surfaceShape": {
    "rounded": { "popup": 8, "panel": 8, "button": 6 },
    "square": { "popup": 0, "panel": 0, "button": 0 }
  },

  "decorationShape": {
    "rounded": { "titlebar": 8 },
    "square": { "titlebar": 0 }
  },

  "buttonStyles": {
    "windows": {
      "plateRadius": 3,
      "closePlate": "#e0655f",
      "closeHover": "0.75",
      "closePressed": "0.55",
      "plainHover": "0.18",
      "plainPressed": "0.3",
      "rest": "0.85",
      "dim": "0.3",
      "width": 28,
      "height": 26
    }
  },

  "opacity": {
    "popup": 0.85,
    "panel": 0.85,
    "tooltip": 0
  }
}
