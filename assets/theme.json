{
  "name": "Vanilla Box Dark",
  "id": "vanilla-box-dark",
  "version": "0.2.0",
  "author": "Sizwe",
  "description": "A minimal, modern look for KDE Plasma 6 — dark variant.",
  "components": [
    {
      "id": "colors",
      "name": "Color scheme",
      "description": "Window and widget colors",
      "source": "color-schemes/VanillaBoxDark.colors",
      "target": "color-schemes",
      "required": true,
      "resolved": [
        {
          "source": "variants/colors/{palette}/VanillaBoxDark.colors",
          "target": ""
        }
      ]
    },
    {
      "id": "plasma-style",
      "name": "Plasma style",
      "description": "Panel, widget and system tray artwork",
      "source": "plasma/desktoptheme/vanilla-box-dark",
      "target": "plasma/desktoptheme",
      "required": true,
      "options": [
        {
          "id": "palette",
          "name": "Colour",
          "description": "Surfaces and the accent that goes with them",
          "kind": "select",
          "defaultValue": "neutral",
          "values": [
            {
              "id": "neutral",
              "name": "Neutral"
            },
            {
              "id": "ash",
              "name": "Ash"
            },
            {
              "id": "slate",
              "name": "Slate"
            },
            {
              "id": "moss",
              "name": "Moss"
            },
            {
              "id": "rose",
              "name": "Rose"
            },
            {
              "id": "plum",
              "name": "Plum"
            }
          ]
        },
        {
          "id": "surfaces",
          "name": "Corners",
          "description": "Panels, popups, buttons and list items",
          "kind": "select",
          "defaultValue": "square",
          "values": [
            {
              "id": "square",
              "name": "Square",
              "overlay": {
                "from": "variants/surfaces/square"
              }
            },
            {
              "id": "rounded",
              "name": "Rounded",
              "overlay": {
                "from": "variants/surfaces/rounded"
              }
            }
          ]
        },
        {
          "id": "transparency-panel",
          "name": "Translucent panel",
          "description": "The panel strip",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/surfaces/{surfaces}/opaque",
            "files": [
              "widgets/panel-background.svg"
            ]
          }
        },
        {
          "id": "transparency-popups",
          "name": "Translucent popups & menus",
          "description": "Launcher and system tray popups",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/surfaces/{surfaces}/opaque",
            "files": [
              "dialogs/background.svg"
            ]
          }
        },
        {
          "id": "transparency-applets",
          "name": "Translucent applets",
          "description": "Plasmoid content areas",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/surfaces/{surfaces}/opaque",
            "files": [
              "widgets/background.svg"
            ]
          }
        }
      ],
      "resolved": [
        {
          "source": "variants/colors/{palette}/colors",
          "target": "colors"
        }
      ]
    },
    {
      "id": "decoration",
      "name": "Window decoration",
      "description": "Titlebar and window buttons",
      "source": "aurorae/themes/VanillaBoxDark",
      "target": "aurorae/themes",
      "required": true,
      "options": [
        {
          "id": "titlebar",
          "name": "Titlebar corners",
          "description": "Top corners of the window frame",
          "kind": "select",
          "defaultValue": "square",
          "values": [
            {
              "id": "square",
              "name": "Square"
            },
            {
              "id": "rounded",
              "name": "Rounded"
            }
          ]
        },
        {
          "id": "buttons",
          "name": "Window buttons",
          "description": "Close, minimise and maximise",
          "kind": "select",
          "defaultValue": "windows",
          "values": [
            {
              "id": "windows",
              "name": "Symbols"
            },
            {
              "id": "mac",
              "name": "Traffic lights",
              "overlay": {
                "from": "variants/buttons/mac"
              }
            }
          ]
        }
      ],
      "resolved": [
        {
          "source": "variants/decoration/{palette}-{titlebar}/decoration.svg",
          "target": "decoration.svg"
        }
      ]
    },
    {
      "id": "global-theme",
      "name": "Global theme",
      "description": "The whole look as one entry in System Settings",
      "source": "plasma/look-and-feel/org.vanillabox.dark",
      "target": "plasma/look-and-feel",
      "required": true,
      "resolved": [
        {
          "source": "variants/defaults/{palette}/defaults",
          "target": "contents/defaults"
        }
      ]
    }
  ]
}
