{
  "name": "Vanilla Box Dark",
  "id": "vanilla-box-dark",
  "version": "0.1.0",
  "author": "Sizwe",
  "description": "A minimal, modern look for KDE Plasma 6 — dark variant.",
  "components": [
    {
      "id": "colors",
      "name": "Color scheme",
      "description": "Window and widget colors",
      "source": "color-schemes/VanillaBoxDark.colors",
      "target": "color-schemes",
      "default": true,
      "resolved": [
        {
          "source": "variants/colors/{tint}-{accent}/VanillaBoxDark.colors",
          "target": ""
        }
      ]
    },
    {
      "id": "plasma-style",
      "name": "Plasma style",
      "description": "Panel, widget and system tray artwork",
      "source": "plasma/desktoptheme/vanilla-box-dark",
      "target": "plasma/desktoptheme",
      "default": true,
      "options": [
        {
          "id": "tint",
          "name": "Surface colour",
          "description": "Panels, popups and window backgrounds",
          "kind": "select",
          "defaultValue": "neutral",
          "values": [
            { "id": "neutral", "name": "Neutral" },
            { "id": "slate", "name": "Slate" },
            { "id": "rose", "name": "Rose" }
          ]
        },
        {
          "id": "accent",
          "name": "Accent",
          "description": "Selection, highlights and the active task",
          "kind": "select",
          "defaultValue": "sand",
          "values": [
            { "id": "sand", "name": "Sand" },
            { "id": "ash", "name": "Ash" },
            { "id": "moss", "name": "Moss" },
            { "id": "steel", "name": "Steel" },
            { "id": "clay", "name": "Clay" },
            { "id": "plum", "name": "Plum" }
          ]
        },
        {
          "id": "surfaces",
          "name": "Corners",
          "description": "Panels, popups, buttons and list items",
          "kind": "select",
          "defaultValue": "rounded",
          "values": [
            { "id": "rounded", "name": "Rounded" },
            {
              "id": "square",
              "name": "Square",
              "overlay": { "from": "variants/surfaces/square" }
            }
          ]
        },
        {
          "id": "transparency-panel",
          "name": "Translucent panel",
          "description": "The panel strip",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/surfaces/{surfaces}/opaque",
            "files": ["widgets/panel-background.svg"]
          }
        },
        {
          "id": "transparency-popups",
          "name": "Translucent popups & menus",
          "description": "Launcher and system tray popups",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/surfaces/{surfaces}/opaque",
            "files": ["dialogs/background.svg"]
          }
        },
        {
          "id": "transparency-applets",
          "name": "Translucent applets",
          "description": "Plasmoid content areas",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/surfaces/{surfaces}/opaque",
            "files": ["widgets/background.svg"]
          }
        }
      ],
      "resolved": [
        {
          "source": "variants/colors/{tint}-{accent}/colors",
          "target": "colors"
        }
      ]
    },
    {
      "id": "decoration",
      "name": "Window decoration",
      "description": "Titlebar and window buttons",
      "source": "aurorae/themes/VanillaBoxDark",
      "target": "aurorae/themes",
      "default": true,
      "resolved": [
        {
          "source": "variants/decoration/{tint}/decoration.svg",
          "target": "decoration.svg"
        }
      ]
    },
    {
      "id": "global-theme",
      "name": "Global theme",
      "description": "The whole look as one entry in System Settings",
      "source": "plasma/look-and-feel/org.vanillabox.dark",
      "target": "plasma/look-and-feel",
      "default": true,
      "resolved": [
        {
          "source": "variants/defaults/{accent}/defaults",
          "target": "contents/defaults"
        }
      ]
    }
  ]
}
