{
  "name": "Vanilla Box Dark",
  "id": "vanilla-box-dark",
  "version": "0.2.0",
  "author": "Sizwe",
  "description": "A minimal, modern look for KDE Plasma 6 — dark variant.",
  "components": [
    {
      "id": "colors",
      "name": "Color scheme",
      "description": "Window and widget colors",
      "source": "color-schemes/VanillaBoxDark.colors",
      "target": "color-schemes",
      "required": true,
      "resolved": [
        {
          "source": "variants/colors/{palette}/VanillaBoxDark.colors",
          "target": ""
        }
      ]
    },
    {
      "id": "plasma-style",
      "name": "Plasma style",
      "description": "Panel, widget and system tray artwork",
      "source": "plasma/desktoptheme/vanilla-box-dark",
      "target": "plasma/desktoptheme",
      "required": true,
      "options": [
        {
          "id": "palette",
          "name": "Surfaces",
          "description": "The tint of the panel, popups and window backgrounds",
          "group": "Surface colour",
          "kind": "select",
          "defaultValue": "neutral",
          "values": [
            {
              "id": "neutral",
              "name": "Neutral",
              "swatch": ["#292929", "#383838"]
            },
            {
              "id": "slate",
              "name": "Slate",
              "swatch": ["#272a2f", "#363b42"]
            },
            {
              "id": "plum",
              "name": "Plum",
              "swatch": ["#2b272d", "#3b353f"]
            },
            {
              "id": "rose",
              "name": "Rose",
              "swatch": ["#2b2729", "#3b3538"]
            },
            {
              "id": "forest",
              "name": "Forest",
              "swatch": ["#252b25", "#343c34"]
            }
          ]
        },
        {
          "id": "containers",
          "name": "Panel & popup corners",
          "description": "The panel strip, menus, tooltips and applet backgrounds",
          "group": "Shape",
          "kind": "select",
          "defaultValue": "rounded",
          "values": [
            {
              "id": "rounded",
              "name": "Rounded",
              "overlay": {
                "from": "variants/containers/rounded"
              }
            },
            {
              "id": "square",
              "name": "Square",
              "overlay": {
                "from": "variants/containers/square"
              }
            }
          ]
        },
        {
          "id": "elements",
          "name": "Button & input corners",
          "description": "Buttons, search bars and list items inside them",
          "group": "Shape",
          "kind": "select",
          "defaultValue": "rounded",
          "values": [
            {
              "id": "rounded",
              "name": "Rounded",
              "overlay": {
                "from": "variants/elements/rounded"
              }
            },
            {
              "id": "square",
              "name": "Square",
              "overlay": {
                "from": "variants/elements/square"
              }
            }
          ]
        },
        {
          "id": "transparency-panel",
          "name": "Translucent panel",
          "description": "The panel strip",
          "group": "Transparency",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/containers/{containers}/opaque",
            "files": [
              "widgets/panel-background.svg"
            ]
          }
        },
        {
          "id": "transparency-popups",
          "name": "Translucent popups & menus",
          "description": "Launcher and system tray popups",
          "group": "Transparency",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/containers/{containers}/opaque",
            "files": [
              "dialogs/background.svg"
            ]
          }
        },
        {
          "id": "transparency-applets",
          "name": "Translucent applets",
          "description": "Plasmoid content areas",
          "group": "Transparency",
          "kind": "toggle",
          "default": true,
          "overlayWhenOff": {
            "from": "variants/containers/{containers}/opaque",
            "files": [
              "widgets/background.svg"
            ]
          }
        }
      ],
      "resolved": [
        {
          "source": "variants/colors/{palette}/colors",
          "target": "colors"
        }
      ]
    },
    {
      "id": "decoration",
      "name": "Window decoration",
      "description": "Titlebar and window buttons",
      "source": "aurorae/themes/VanillaBoxDark",
      "target": "aurorae/themes",
      "required": true,
      "options": [
        {
          "id": "titlebar",
          "name": "Titlebar corners",
          "description": "Top corners of the window frame",
          "group": "Shape",
          "kind": "select",
          "defaultValue": "rounded",
          "values": [
            {
              "id": "rounded",
              "name": "Rounded"
            },
            {
              "id": "square",
              "name": "Square"
            }
          ]
        },
        {
          "id": "buttons",
          "name": "Window buttons",
          "description": "Close, minimise and maximise",
          "group": "Shape",
          "kind": "select",
          "defaultValue": "mac",
          "values": [
            {
              "id": "mac",
              "name": "Traffic lights",
              "description": "(similar to Mac)",
              "overlay": {
                "from": "variants/buttons/mac"
              }
            },
            {
              "id": "windows",
              "name": "Symbols",
              "description": "(similar to Windows)",
              "overlay": {
                "from": "variants/buttons/windows"
              }
            }
          ]
        }
      ],
      "resolved": [
        {
          "source": "variants/decoration/{palette}-{titlebar}/decoration.svg",
          "target": "decoration.svg"
        }
      ]
    },
    {
      "id": "global-theme",
      "name": "Global theme",
      "description": "The whole look as one entry in System Settings",
      "source": "plasma/look-and-feel/org.vanillabox.dark",
      "target": "plasma/look-and-feel",
      "required": true,
      "options": [
        {
          "id": "icons",
          "name": "Icons",
          "description": "Phosphor icons for the tray, launcher and menus",
          "group": "Icons",
          "kind": "select",
          "defaultValue": "off",
          "values": [
            {
              "id": "off",
              "name": "Keep my icons",
              "description": "(leaves your current icon theme alone)"
            },
            {
              "id": "on",
              "name": "Vanilla Box icons",
              "description": "(installs and switches to them)"
            }
          ]
        }
      ],
      "resolved": [
        {
          "source": "variants/defaults/{palette}-{icons}/defaults",
          "target": "contents/defaults"
        }
      ]
    },
    {
      "id": "icons",
      "name": "Icons",
      "description": "System tray, launcher and menu icons",
      "source": "icons/VanillaBoxIconsDark",
      "target": "icons",
      "installedWhen": {
        "option": "icons",
        "value": "on"
      }
    }
  ]
}
